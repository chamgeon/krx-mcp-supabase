# Env for `supabase functions serve` during tests (see supabase/tests/mcp_test.ts). Committed on purpose: every
# value is a dummy. Never put real keys here, and don't point tests at supabase/.env (it has the real ones).
MCP_ACCESS_KEY=local-test-key
KIS_APP_KEY=dummy
KIS_APP_SECRET=dummy
KRX_API_KEY=dummy
INGEST_SECRET=dummy
# Public URL of the local stack (the token issuer); inside Docker SUPABASE_URL is http://kong:8000
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
